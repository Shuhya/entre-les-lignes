{
  "root": true,
  "env": { "browser": true, "es2022": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "script" },
  "globals": { "IMG": "readonly", "S": "readonly", "STORIES": "readonly" },
  "rules": {
    "no-undef": "error",
    "no-redeclare": "error",
    "no-dupe-keys": "error",
    "no-dupe-args": "error",
    "no-func-assign": "error",
    "no-unreachable": "error",
    "no-unused-vars": "warn"
  },
  "overrides": [
    { "files": ["scripts/**"], "env": { "node": true } },
    { "files": ["sw.js"], "env": { "serviceworker": true, "browser": true } },
    { "files": ["build/**"], "env": { "node": true } }
  ]
}
